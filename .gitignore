# Godot 4+
.godot/
/android/

# Exported / build artifacts (Steam uploads are built from here, not committed)
build/
builds/
export/
*.pck
*.exe.manifest

# EXR files (prevent accidental commits)
*.exr
*.exr.import

# Test reports (gdUnit4)
reports/

# Temp / scratch
temp/
test_output.txt
test_stderr.txt
test_stdout.txt
TODO_TOMORROW.md

# Python (tooling / Houdini bridge / graphify)
**/__pycache__/
**/*.pyc
**/*.pyo
.venv/

# Graphify — entirely local-only generated knowledge graph (any depth, e.g. godot/graphify-out/)
.graphify_*
**/graphify-out/

# Godot MCP bridge — generated screenshots / cache (local-only)
**/addons/godot_mcp/cache/

# OS
.DS_Store
Thumbs.db

# Concept art — local-only exploration workspace (image binaries + WIP style profiles), never committed
concept-art/

# Claude Code — local session / agent state
.claude/
